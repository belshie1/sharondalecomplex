# Copy to .env (never commit .env) before running:
#   docker compose up -d
#
# `npm start` also reads .env.local and then .env from the project root, so the
# Supabase block at the bottom can live in .env.local for local development.
# A variable already set in the environment always wins over these files.
#
# SHARONDALE_TOKEN is the code caretakers type into the dashboard once to be
# able to change the board. Pick something only the complex staff know.
SHARONDALE_TOKEN=change-me

# The Tailscale auth key for the machine that hosts the app. Create one at
# https://login.tailscale.com/admin/settings/keys - reusable and pre-approved
# (pre-approval is what lets Serve publish HTTPS without a manual approval).
TS_AUTHKEY=tskey-auth-replace-me

# The name the app gets on your tailnet: https://<this>.<tailnet>.ts.net
SHARONDALE_HOSTNAME=sharondale

# Only needed if the dashboard is ALSO hosted somewhere static (e.g. GitHub
# Pages) and must call this backend. Comma-separated, no trailing slash:
# SHARONDALE_ALLOWED_ORIGINS=https://belshie1.github.io
SHARONDALE_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Cloud storage (optional). Setting SUPABASE_URL and a key switches the board
# from SQLite to Supabase Postgres - see DEPLOY.md, "Option 0".
#
# SUPABASE_DB_URL is the "Session pooler" connection string from Supabase
# (Connect -> Session pooler). It is what you want: plain IPv4 Postgres.
# Leave it empty and the app tries the direct host, then falls back to the HTTPS
# Data API automatically - that path needs the table created by hand (run
# server/supabase-schema.sql once), which is the only thing the pooler does
# better. SUPABASE_TRANSPORT=rest or =tcp pins the choice and skips the probe.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_DB_URL=
# SUPABASE_TRANSPORT=
